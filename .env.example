# Copy to .env and adjust. The app loads this file automatically
# (python-dotenv) when running via `uv run uvicorn apps.api.main:app`;
# Docker Compose also passes it via env_file.

POLICY_PATH=policies/policy.yaml
AUDIT_DB_PATH=audit.db

# Which risk classifier implementation to use.
# "mock" (default) -> KeywordMockClassifier, zero network calls.
# "groq" -> GroqRiskClassifier (real LLM-backed classifier).
LLM_PROVIDER=mock
# Uncomment to use the Groq-backed classifier:
# LLM_PROVIDER=groq

# Generative LLM provider for post-ALLOW response generation. Configured
# INDEPENDENTLY of the risk-classifier provider above.
# Unset = no generation wired; ALLOW responses return a null response field.
# LLM_GENERATION_PROVIDER=groq
# ─── Auth ──────────────────────────────────────────────────────────────────────
# Required when AUTH_DEV_MODE=false: a strong random shared secret for HS256
# JWT verification. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=
# Set true only in local development. In any deployed environment this must be false
# so that /auth/dev-token does not exist and only real IdP-issued tokens are accepted.
AUTH_DEV_MODE=false


# Output guardrail: inspects generated responses for claims not grounded in
# the prompt BEFORE they reach the employee (runs only after a policy ALLOW).
# Unset = stage skipped entirely. Flagged/failed checks route the response to
# flagged-for-review instead of returning it.
# OUTPUT_GUARDRAIL_PROVIDER=groq

# Groq credentials. Put your real API key in .env (gitignored) — never here.
# This file must stay placeholder-only in version control.
GROQ_API_KEY=

# Default model: openai/gpt-oss-20b (Groq strict structured outputs).
GROQ_MODEL=openai/gpt-oss-20b

# Timeout in seconds for a single Groq inference call.
GROQ_TIMEOUT=10
# --- Optical / multimodal (P0) ---
# OCR provider for POST /guardrail/evaluate-image.
# "mock" (default) -> MockOCRProvider, offline, no system binaries.
# "tesseract" -> local Tesseract (requires pytesseract extra + tesseract binary).
OPTICAL_OCR_PROVIDER=mock
# OPTICAL_OCR_PROVIDER=tesseract

# Maximum uploaded image size in bytes (default 10 MB).
OPTICAL_MAX_IMAGE_BYTES=10485760
