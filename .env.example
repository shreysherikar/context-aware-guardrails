# Copy to .env and adjust. The app loads this file automatically
# (python-dotenv) when running via `uv run uvicorn apps.api.main:app`;
# Docker Compose also passes it via env_file.

POLICY_PATH=policies/policy.yaml
AUDIT_DB_PATH=audit.db

# CORS: comma-separated list of allowed browser origins, e.g.
# ALLOWED_ORIGINS=https://d123abc.cloudfront.net,http://localhost:5173
# The API uses bearer-token auth, so "*" is rejected at startup (wildcard
# origins with credentials are insecure and blocked by browsers anyway).
# Unset = no browser CORS access; non-browser clients are unaffected.
ALLOWED_ORIGINS=

# Serve the built same-origin frontend (apps/web) from this API via StaticFiles.
# Off by default — the frontend is deployed separately on S3/CloudFront. Set to
# "true" only when hosting the dashboard and API on the same origin.
SERVE_STATIC_FRONTEND=false

# Production storage: one shared PostgreSQL database. When set, the audit log,
# the governance audit log, and the guardrail review store all use THIS database
# instead of their local SQLite files (AUDIT_DB_PATH / GOVERNANCE_AUDIT_DB_PATH /
# GUARDRAIL_REVIEW_DB_PATH are then ignored). Unset = SQLite local fallback.
# DATABASE_URL=postgresql://user:password@localhost:5432/guardrails

# Trusted evidence corpus for claim/evidence verification (evidence plane).
# Unset -> repository default evidence/approved_sources.yaml.
# EVIDENCE_CORPUS_PATH=evidence/approved_sources.yaml

# Which risk classifier implementation to use.
# "mock" (default) -> KeywordMockClassifier, zero network calls.
# "groq" -> GroqRiskClassifier (real LLM-backed classifier).
LLM_PROVIDER=mock
# Uncomment to use the Groq-backed classifier:
# LLM_PROVIDER=groq

# Generative LLM provider for post-ALLOW response generation. Configured
# INDEPENDENTLY of the risk-classifier provider above.
# Unset = no generation wired; ALLOW responses return a null response field.
# LLM_GENERATION_PROVIDER=groq
# LLM_GENERATION_PROVIDER=ollama

# Local Ollama (when LLM_GENERATION_PROVIDER=ollama and/or OPTICAL_OCR_PROVIDER=ollama).
# Requires `ollama serve` and a pulled model (vision-capable for optical OCR).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.6:latest
# OLLAMA_VISION_MODEL=qwen3.6:latest
# OLLAMA_TIMEOUT=180

# Agent: use local LLM to phrase guardrail feedback (issues + corrections).
# AGENT_LLM_FEEDBACK=true

# Web bridge — DuckDuckGo search (no API key). Runs after guardrails pass.
# WEB_SEARCH_AUTO=true
# WEB_SEARCH_MAX_RESULTS=5
# ─── Auth ──────────────────────────────────────────────────────────────────────
# Required when AUTH_DEV_MODE=false: a strong random shared secret for HS256
# JWT verification. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_JWT_SECRET=
# Set true only in local development. In any deployed environment this must be false
# so that /auth/dev-token does not exist and only real IdP-issued tokens are accepted.
AUTH_DEV_MODE=false


# Output guardrail: inspects generated responses for claims not grounded in
# the prompt BEFORE they reach the employee (runs only after a policy ALLOW).
# Unset = stage skipped entirely. Flagged/failed checks route the response to
# flagged-for-review instead of returning it.
# OUTPUT_GUARDRAIL_PROVIDER=groq

# Post-generation claim/evidence verification against the trusted approved-source
# corpus (evidence/approved_sources.yaml; path overridable via EVIDENCE_CORPUS_PATH).
# Runs after generation, independently of the output guardrail above: generated
# claims are extracted, matched against approved sources and assessed as
# supported / contradicted / conflicting / insufficient. Anything not fully
# supported is routed to human review via the EVIDENCE-001 policy rule.
# Unset = stage skipped entirely (no added latency, existing behavior unchanged).
# CLAIM_VERIFICATION_PROVIDER=deterministic

# ── DEMO UI (optional, no code change needed) ─────────────────────────────────
# To see real generated responses in the demo UI at GET /, add BOTH of these to
# your LOCAL .env (never save a real key here — .env.example is a version-controlled
# template, and a real key would be committed with it):
#     LLM_GENERATION_PROVIDER=groq
#     GROQ_API_KEY=<your key>
# With LLM_PROVIDER=mock and no generation provider set, ALLOW/REWRITE still pass
# the policy gate but return a null response field — correct behaviour, and the
# demo UI labels it as such.
GROQ_API_KEY=

# Default model: openai/gpt-oss-20b (Groq strict structured outputs).
GROQ_MODEL=openai/gpt-oss-20b

# Timeout in seconds for a single Groq inference call.
GROQ_TIMEOUT=10

# ─── NeMo Guardrails (defense-in-depth) ───────────────────────────────────────
# Optional NVIDIA NeMo Guardrails layer. Augments (never replaces) the existing
# classifier, SanitizationEngine, policy engine, and output guardrail stack.
# NEMO_GUARDRAILS_ENABLED=false
# NEMO_GUARDRAILS_CONFIG_PATH=services/nemo_guardrail/config
# NEMO_GUARDRAILS_TIMEOUT=15
# Comma-separated rails to activate: input, output, dialog
# NEMO_GUARDRAILS_MODE=input,output,dialog
# Install optional dependency: pip install 'context-aware-guardrail[nemo]'

# --- Optical / multimodal (P0) ---
# OCR provider for POST /guardrail/evaluate-image.
# "mock" (default) -> MockOCRProvider, offline, no system binaries.
# "tesseract" -> local Tesseract (requires pytesseract extra + tesseract binary).
# "ollama" -> vision model via local Ollama (no Tesseract required).
OPTICAL_OCR_PROVIDER=mock
# OPTICAL_OCR_PROVIDER=tesseract
# OPTICAL_OCR_PROVIDER=ollama

# Maximum uploaded image size in bytes (default 10 MB).
OPTICAL_MAX_IMAGE_BYTES=10485760
