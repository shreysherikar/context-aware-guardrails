# Copy to .env and fill in. Values here are read at build/bundle time by Expo
# (anything prefixed EXPO_PUBLIC_ is inlined into the client bundle - do not
# put secrets here, same rule as the web app's .env.production).

# Base URL of the ContextGuard AI backend (no trailing slash needed - the
# client strips one defensively either way).
EXPO_PUBLIC_API_BASE_URL=https://your-backend-host.example.com
