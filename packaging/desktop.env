# ContextGuard desktop defaults — local Llama via Ollama.
# Keep this file next to ContextGuard.exe. Ollama must be running:
#   ollama serve
#   ollama pull llama3.2:3b

LLM_GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=600
LLM_PROVIDER=mock
OPTICAL_OCR_PROVIDER=mock
AUTH_DEV_MODE=true
SERVE_STATIC_FRONTEND=true
# clinician@contextguard.local / clinician  (same pattern for admin, marketing, employee)
# AUTH_PASSWORD_USERS=
